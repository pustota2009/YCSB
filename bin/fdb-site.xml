<configuration>
    <property>
        <name>fdb.zookeeper.connection.string</name>
        <value>localhost:2181</value>
    </property>
    <property>
        <name>fdb.zookeeper.path</name>
        <value>/fdb</value>
    </property>
    <property>
        <name>fdb.zookeeper.retry.count</name>
        <value>5</value>
    </property>
    <property>
        <name>fdb.zookeeper.retry.delay.ms</name>
        <value>3000</value>
    </property>
    <property>
        <name>fdb.zookeeper.session.timeout.ms</name>
        <value>45000</value>
    </property>
    <property>
        <name>fdb.security.authentication</name>
        <value>NONE</value>
    </property>
    <property>
        <name>fdb.security.spn</name>
        <value>fdb</value>
    </property>
    <property>
        <name>fdb.security.login</name>
        <value>fdb-client</value>
    </property>
    <property>
        <name>fdb.security.keytab</name>
        <value>specs/config/fdb-client.keytab</value>
    </property>
    <property>
        <name>fdb.security.authorization</name>
        <value>true</value>
    </property>
    <property>
        <name>fdb.master.connection.timeout.ms</name>
        <value>30000</value>
    </property>
    <property>
        <name>fdb.master.disconnection.timeout.ms</name>
        <value>5000</value>
    </property>
    <property>
        <name>fdb.create.namespace.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.create.table.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.enable.table.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.disable.table.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.drop.table.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.move.region.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.split.region.timeout.ms</name>
        <value>600000</value>
    </property>
    <property>
        <name>fdb.rebalance.region.start.timeout.ms</name>
        <value>60000</value>
    </property>
    <property>
        <name>fdb.stop.rebalance.tasks.timeout.ms</name>
        <value>60000</value>
    </property>
    <property>
        <name>fdb.security.token.retry.timeout.ms</name>
        <value>1000</value>
    </property>
    <property>
        <name>fdb.security.token.retry.count</name>
        <value>5</value>
    </property>
    <property>
        <name>fdb.transport.enable.table.map.timeout</name>
        <value>true</value>
    </property>
    <property>
        <name>fdb.client.enable.bulk.api</name>
        <value>true</value>
    </property>
    <property>
        <name>fdb.hbase.scan.filter</name>
        <value>true</value>
    </property>
    <property>
        <name>fdb.transport.socket.timeout</name>
        <value>120000</value>
    </property>
    <property>
        <name>fdb.connection.pool.size</name>
        <value>100</value>
    </property>
    <property>
        <name>fdb.connection.pool.reusable</name>
        <value>true</value>
    </property>

</configuration>